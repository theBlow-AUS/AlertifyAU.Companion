{
  "name": "@workspace/alertify-companion",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build-privacy.cjs && node scripts/build.js",
    "build:privacy": "node scripts/build-privacy.cjs",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:watch-model": "node scripts/check-watch-model.cjs",
    "test:weather": "node scripts/check-weather.cjs",
    "test:route-coverage": "node scripts/check-route-coverage.cjs",
    "test:route-coverage:mapbox": "node scripts/check-route-coverage.cjs --mapbox",
    "test:fire-district": "node scripts/check-fire-district.cjs",
    "test:alerts": "node scripts/check-alert-matching.cjs && node scripts/check-location-runtime.cjs",
    "test:updates": "node scripts/check-unified-updates.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "catalog:",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.2.3",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "create-launch": "0.4.1",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.18",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react-dom": "19.3.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "zod": "catalog:",
    "zod-validation-error": "^5.0.0"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-background-task": "~58.0.11",
    "expo-notifications": "~58.1.6",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-webview": "14.0.1"
  }
}
