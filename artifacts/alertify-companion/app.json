{
  "expo": {
    "name": "Alertify.au Companion",
    "slug": "alertify-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/companion-icon.png",
    "scheme": "alertify-companion",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["comgooglemaps", "waze"],
        "NSLocationWhenInUseUsageDescription": "Alertify.au Companion uses your location only when you choose to check fire danger, save a watch address, or select a trip starting point."
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/companion-icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-background-task",
      ["expo-splash-screen", { "image": "./assets/images/companion-icon.png", "backgroundColor": "#1b2b37", "resizeMode": "contain" }],
      ["expo-location", { "locationWhenInUsePermission": "Alertify.au Companion uses your location only when you choose to save home or select a trip starting point." }],
      ["expo-notifications", { "defaultChannel": "default", "color": "#287bb6" }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
